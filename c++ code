static COLORREF g_rainbowAccent = RGB(255,0,128);
static double   g_rainbowPhase = 0.0;

static COLORREF HsvToRgb(double h, double s, double v) {
    double r=0,g=0,b=0;
    h = fmod(h, 360.0); if (h < 0) h += 360.0;
    int i = (int)(h / 60.0) % 6;
    double f = h / 60.0 - floor(h / 60.0);
    double p = v * (1 - s), q = v * (1 - s*f), t = v * (1 - s*(1-f));
    switch (i) {
    case 0: r=v; g=t; b=p; break;
    case 1: r=q; g=v; b=p; break;
    case 2: r=p; g=v; b=t; break;
    case 3: r=p; g=q; b=v; break;
    case 4: r=t; g=p; b=v; break;
    default:r=v; g=p; b=q; break;
    }
    return RGB((int)(r*255),(int)(g*255),(int)(b*255));
}

static void UpdateRainbow() {
    if (!g_theme->rainbow) { g_rainbowAccent = g_theme->accent; return; }
    g_rainbowPhase += 1.5;
    if (g_rainbowPhase > 360.0) g_rainbowPhase -= 360.0;
    g_rainbowAccent = HsvToRgb(g_rainbowPhase, 0.75, 1.0);
}

static COLORREF CurrentAccent() {
    return g_theme->rainbow ? g_rainbowAccent : g_theme->accent;
}

static void ApplyTheme(const std::wstring& name) {
    for (int i = 0; i < kThemeCount; ++i) {
        if (_wcsicmp(kThemes[i].name, name.c_str()) == 0) { g_theme = &kThemes[i]; break; }
    }
    if (g_hwnd) {
        LONG_PTR ex = GetWindowLongPtrW(g_hwnd, GWL_EXSTYLE);
        if (g_theme->transparent) {
            SetWindowLongPtrW(g_hwnd, GWL_EXSTYLE, ex | WS_EX_LAYERED);
            SetLayeredWindowAttributes(g_hwnd, 0, 235, LWA_ALPHA);
        } else {
            SetWindowLongPtrW(g_hwnd, GWL_EXSTYLE, ex & ~WS_EX_LAYERED);
        }
    }
}
static const Theme* NextTheme(const std::wstring& cur) {
    for (int i = 0; i < kThemeCount; ++i) {
        if (_wcsicmp(kThemes[i].name, cur.c_str()) == 0) return &kThemes[(i + 1) % kThemeCount];
    }
    return &kThemes[0];
}

