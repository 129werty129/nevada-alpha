static std::wstring IniGet(const wchar_t* sec, const wchar_t* key, const wchar_t* def, const wchar_t* file = kIni) {
    wchar_t buf[512]{};
    GetPrivateProfileStringW(sec, key, def, buf, 512, file);
    return buf;
}
static int IniGetInt(const wchar_t* sec, const wchar_t* key, int def, const wchar_t* file = kIni) {
    return (int)GetPrivateProfileIntW(sec, key, def, file);
}
static void IniSet(const wchar_t* sec, const wchar_t* key, const std::wstring& v, const wchar_t* file = kIni) {
    WritePrivateProfileStringW(sec, key, v.c_str(), file);
}
static void IniSetInt(const wchar_t* sec, const wchar_t* key, int v, const wchar_t* file = kIni) {
    IniSet(sec, key, std::to_wstring(v), file);
}

static void LoadSettings() {
    g.bhopKey = IniGet(L"Bhop", L"Key", L"XButton1");
    g.bhopDelay = std::clamp(IniGetInt(L"Bhop", L"Delay", 15), 1, 100);
    g.triggerKey = IniGet(L"Trigger", L"Key", L"X");
    g.shootKey = IniGet(L"Trigger", L"ShootKey", L"LButton");
    g.threshold = std::clamp(IniGetInt(L"Trigger", L"Threshold", 20), 0, 255);
    g.shootDelay = std::clamp(IniGetInt(L"Trigger", L"ShootDelay", 1), 1, 500);
    g.theme = IniGet(L"Theme", L"Name", L"Dark");
    ApplyTheme(g.theme);
}
static void SaveSettings(const wchar_t* file = kIni) {
    IniSet(L"Bhop", L"Key", g.bhopKey, file);
    IniSetInt(L"Bhop", L"Delay", g.bhopDelay, file);
    IniSet(L"Trigger", L"Key", g.triggerKey, file);
    IniSet(L"Trigger", L"ShootKey", g.shootKey, file);
    IniSetInt(L"Trigger", L"Threshold", g.threshold, file);
    IniSetInt(L"Trigger", L"ShootDelay", g.shootDelay, file);
    IniSet(L"Theme", L"Name", g.theme, file);
