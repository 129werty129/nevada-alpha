static void SendKeyTap(WORD vk) {
    INPUT in[2]{};
    in[0].type = INPUT_KEYBOARD; in[0].ki.wVk = vk;
    in[1] = in[0]; in[1].ki.dwFlags = KEYEVENTF_KEYUP;
    SendInput(2, in, sizeof(INPUT));
}
static void SendMouseButton(WORD flag) {
    INPUT in[2]{};
    in[0].type = INPUT_MOUSE; in[1].type = INPUT_MOUSE;
    if (flag == RI_MOUSE_LEFT_BUTTON_DOWN) {
        in[0].mi.dwFlags = MOUSEEVENTF_LEFTDOWN; in[1].mi.dwFlags = MOUSEEVENTF_LEFTUP;
    }
    else if (flag == RI_MOUSE_RIGHT_BUTTON_DOWN) {
        in[0].mi.dwFlags = MOUSEEVENTF_RIGHTDOWN; in[1].mi.dwFlags = MOUSEEVENTF_RIGHTUP;
    }
    else if (flag == RI_MOUSE_MIDDLE_BUTTON_DOWN) {
        in[0].mi.dwFlags = MOUSEEVENTF_MIDDLEDOWN; in[1].mi.dwFlags = MOUSEEVENTF_MIDDLEUP;
    }
    else {
        in[0].mi.dwFlags = MOUSEEVENTF_XDOWN; in[1].mi.dwFlags = MOUSEEVENTF_XUP;
        in[0].mi.mouseData = in[1].mi.mouseData =
            (flag == RI_MOUSE_BUTTON_4_DOWN) ? XBUTTON1 : XBUTTON2;
    }
    SendInput(2, in, sizeof(INPUT));
}
static void TapShoot() {
    if (auto* k = FindKey(g.shootKey)) {
        if (k->mouse) SendMouseButton(k->mouseFlag);
        else          SendKeyTap(k->vk);
    }
}

// ==================== ТРИГГЕР ====================
static void TriggerWorker() {
    while (!g_shutdown) {
        while (!g_triggerRunning && !g_shutdown) Sleep(5);
        if (g_shutdown) break;

        POINT pt{};
        if (!GetCursorPos(&pt)) { g_triggerRunning = false; continue; }
        HDC dc = GetDC(nullptr);
        COLORREF base = GetPixel(dc, pt.x + 2, pt.y + 2);
        ReleaseDC(nullptr, dc);
        if (base == CLR_INVALID) { g_triggerRunning = false; continue; }

        int r1 = GetRValue(base), g1 = GetGValue(base), b1 = GetBValue(base);

        while (g_triggerRunning && !g_shutdown) {
            Sleep(g.shootDelay);
            if (!GetCursorPos(&pt)) break;
            HDC d2 = GetDC(nullptr);
            COLORREF c2 = GetPixel(d2, pt.x + 2, pt.y + 2);
            ReleaseDC(nullptr, d2);
            if (c2 == CLR_INVALID) continue;
            int r2 = GetRValue(c2), g2 = GetGValue(c2), b2 = GetBValue(c2);
            int t = g.threshold;
            if (abs(r1 - r2) > t || abs(g1 - g2) > t || abs(b1 - b2) > t) {
                TapShoot();
            }
        }
    }
}

// ==================== ХУКИ ====================
static bool NameIsKeyboard(const std::wstring& n, DWORD vk) {
    auto* k = FindKey(n);
    return k && !k->mouse && k->vk == vk;
}
static void OnKeyDownForTrigger() { if (!g_triggerHeld.exchange(true)) g_triggerRunning = true; }
static void OnKeyUpForTrigger()   { if (g_triggerHeld.exchange(false)) g_triggerRunning = false; }
static void OnKeyDownForBhop()    { if (!g_bhopHeld.exchange(true)) SetTimer(g_hwnd, g_bhopTimer, g.bhopDelay, nullptr); }
static void OnKeyUpForBhop()      { if (g_bhopHeld.exchange(false)) KillTimer(g_hwnd, g_bhopTimer); }

static LRESULT CALLBACK KbProc(int nCode, WPARAM wp, LPARAM lp) {
    if (nCode == HC_ACTION) {
        auto* kb = (KBDLLHOOKSTRUCT*)lp;
        bool isDown = (wp == WM_KEYDOWN || wp == WM_SYSKEYDOWN);
        bool isUp = (wp == WM_KEYUP || wp == WM_SYSKEYUP);
        if (NameIsKeyboard(g.bhopKey, kb->vkCode)) {
            if (isDown) OnKeyDownForBhop(); else if (isUp) OnKeyUpForBhop();
        }
        if (NameIsKeyboard(g.triggerKey, kb->vkCode)) {
            if (isDown) OnKeyDownForTrigger(); else if (isUp) OnKeyUpForTrigger();
        }
    }
    return CallNextHookEx(g_kbHook, nCode, wp, lp);
}
static bool MouseMatches(const std::wstring& name, WPARAM wp, DWORD mouseData) {
    auto* k = FindKey(name);
    if (!k || !k->mouse) return false;
    if (k->mouseFlag == RI_MOUSE_LEFT_BUTTON_DOWN)
        return wp == WM_LBUTTONDOWN || wp == WM_LBUTTONUP;
    if (k->mouseFlag == RI_MOUSE_RIGHT_BUTTON_DOWN)
        return wp == WM_RBUTTONDOWN || wp == WM_RBUTTONUP;
    if (k->mouseFlag == RI_MOUSE_MIDDLE_BUTTON_DOWN)
        return wp == WM_MBUTTONDOWN || wp == WM_MBUTTONUP;
    WORD xb = HIWORD(mouseData);
    return ((k->mouseFlag == RI_MOUSE_BUTTON_4_DOWN && xb == XBUTTON1) ||
        (k->mouseFlag == RI_MOUSE_BUTTON_5_DOWN && xb == XBUTTON2));
}
static LRESULT CALLBACK MouseProc(int nCode, WPARAM wp, LPARAM lp) {
    if (nCode == HC_ACTION) {
        auto* ms = (MSLLHOOKSTRUCT*)lp;
        bool isDown = (wp == WM_LBUTTONDOWN || wp == WM_RBUTTONDOWN || wp == WM_MBUTTONDOWN || wp == WM_XBUTTONDOWN);
        bool isUp = (wp == WM_LBUTTONUP || wp == WM_RBUTTONUP || wp == WM_MBUTTONUP || wp == WM_XBUTTONUP);
        if (MouseMatches(g.bhopKey, wp, ms->mouseData)) {
            if (isDown) OnKeyDownForBhop(); else if (isUp) OnKeyUpForBhop();
        }
        if (MouseMatches(g.triggerKey, wp, ms->mouseData)) {
            if (isDown) OnKeyDownForTrigger(); else if (isUp) OnKeyUpForTrigger();
        }
    }
    return CallNextHookEx(g_mouseHook, nCode, wp, lp);
}
static void InstallHooks() {
    HINSTANCE inst = GetModuleHandleW(nullptr);
    g_kbHook = SetWindowsHookExW(WH_KEYBOARD_LL, KbProc, inst, 0);
    g_mouseHook = SetWindowsHookExW(WH_MOUSE_LL, MouseProc, inst, 0);
    g_triggerThread = std::thread(TriggerWorker);
}
static void UninstallHooks() {
    if (g_kbHook) { UnhookWindowsHookEx(g_kbHook);    g_kbHook = nullptr; }
    if (g_mouseHook) { UnhookWindowsHookEx(g_mouseHook); g_mouseHook = nullptr; }
    KillTimer(g_hwnd, g_bhopTimer);
    g_bhopHeld = false;
    g_triggerRunning = false;
    g_triggerHeld = false;
    g_shutdown = true;
    if (g_triggerThread.joinable()) g_triggerThread.join();
}

