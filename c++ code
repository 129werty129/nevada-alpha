struct InputBoxData { std::wstring result; bool ok = false; HWND edit = nullptr; };
static LRESULT CALLBACK InputBoxProc(HWND h, UINT m, WPARAM wp, LPARAM lp) {
    auto* d = (InputBoxData*)GetWindowLongPtrW(h, GWLP_USERDATA);
    switch (m) {
    case WM_COMMAND:
        if (LOWORD(wp) == IDOK) {
            wchar_t buf[256]{}; GetDlgItemTextW(h, 101, buf, 256);
            d->result = buf; d->ok = true; DestroyWindow(h);
        }
        else if (LOWORD(wp) == IDCANCEL) DestroyWindow(h);
        return 0;
    case WM_CLOSE: DestroyWindow(h); return 0;
    }
    return DefWindowProcW(h, m, wp, lp);
}
static bool ShowInputBox(HWND owner, const wchar_t* title, const wchar_t* prompt,
    const std::wstring& initial, std::wstring& out) {
    static bool reg = false;
    if (!reg) {
        WNDCLASSW wc{};
        wc.lpfnWndProc = InputBoxProc;
        wc.hInstance = GetModuleHandleW(nullptr);
        wc.lpszClassName = kInputClass;
        wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
        wc.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);
        RegisterClassW(&wc); reg = true;
    }
    InputBoxData d;
    HWND h = CreateWindowExW(WS_EX_DLGMODALFRAME, kInputClass, title,
        WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_VISIBLE,
        CW_USEDEFAULT, CW_USEDEFAULT, 340, 175, owner, nullptr,
        GetModuleHandleW(nullptr), nullptr);
    SetWindowLongPtrW(h, GWLP_USERDATA, (LONG_PTR)&d);
    CreateWindowW(L"STATIC", prompt, WS_CHILD | WS_VISIBLE, 15, 15, 310, 40, h, nullptr, nullptr, nullptr);
    d.edit = CreateWindowExW(WS_EX_CLIENTEDGE, L"EDIT", initial.c_str(),
        WS_CHILD | WS_VISIBLE | ES_AUTOHSCROLL, 15, 55, 310, 24, h, (HMENU)101, nullptr, nullptr);
    CreateWindowW(L"BUTTON", L"OK", WS_CHILD | WS_VISIBLE | BS_DEFPUSHBUTTON,
        165, 100, 75, 28, h, (HMENU)IDOK, nullptr, nullptr);
    CreateWindowW(L"BUTTON", L"Cancel", WS_CHILD | WS_VISIBLE,
        250, 100, 75, 28, h, (HMENU)IDCANCEL, nullptr, nullptr);
    SendMessageW(d.edit, EM_SETSEL, 0, -1);
    SetFocus(d.edit);
    EnableWindow(owner, FALSE);
    MSG msg{};
    while (IsWindow(h) && GetMessageW(&msg, nullptr, 0, 0) > 0) {
        if (msg.message == WM_KEYDOWN && msg.wParam == VK_ESCAPE) { DestroyWindow(h); break; }
        if (msg.message == WM_KEYDOWN && msg.wParam == VK_RETURN && GetFocus() == d.edit) {
            SendMessageW(h, WM_COMMAND, IDOK, 0); continue;
        }
        TranslateMessage(&msg); DispatchMessageW(&msg);
    }
    EnableWindow(owner, TRUE); SetActiveWindow(owner);
    if (d.ok) out = d.result;
    return d.ok;
}

