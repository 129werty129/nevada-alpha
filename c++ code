// ==================== КОНФИГИ ====================
static std::wstring ConfigPath(const std::wstring& name) {
    wchar_t exe[MAX_PATH]{};
    GetModuleFileNameW(nullptr, exe, MAX_PATH);
    std::wstring dir = exe;
    size_t pos = dir.find_last_of(L"\\/");
    if (pos != std::wstring::npos) dir = dir.substr(0, pos + 1);
    return dir + L"cfg_" + name + L".ini";
}
static void ConfigSave() {
    std::wstring name;
    if (ShowInputBox(g_hwnd, L"nevada - by werty129129", L"Config name to SAVE:", L"default", name) && !name.empty()) {
        SaveSettings(ConfigPath(name).c_str());
    }
}
static void ConfigLoad() {
    std::wstring name;
    if (ShowInputBox(g_hwnd, L"nevada - by werty129129", L"Config name to LOAD:", L"default", name) && !name.empty()) {
        std::wstring path = ConfigPath(name);
        if (GetFileAttributesW(path.c_str()) != INVALID_FILE_ATTRIBUTES) {
            g.bhopKey = IniGet(L"Bhop", L"Key", g.bhopKey.c_str(), path.c_str());
            g.bhopDelay = std::clamp(IniGetInt(L"Bhop", L"Delay", g.bhopDelay, path.c_str()), 1, 100);
            g.triggerKey = IniGet(L"Trigger", L"Key", g.triggerKey.c_str(), path.c_str());
            g.shootKey = IniGet(L"Trigger", L"ShootKey", g.shootKey.c_str(), path.c_str());
            g.threshold = std::clamp(IniGetInt(L"Trigger", L"Threshold", g.threshold, path.c_str()), 0, 255);
            g.shootDelay = std::clamp(IniGetInt(L"Trigger", L"ShootDelay", g.shootDelay, path.c_str()), 1, 500);
            g.theme = IniGet(L"Theme", L"Name", g.theme.c_str(), path.c_str());
            ApplyTheme(g.theme);
            SaveSettings(); 
            InvalidateRect(g_hwnd, nullptr, TRUE);
        }
    }
}
static void ConfigDelete() {
    std::wstring name;
    if (ShowInputBox(g_hwnd, L"nevada - by werty129129", L"Config name to DELETE:", L"default", name) && !name.empty()) {
        DeleteFileW(ConfigPath(name).c_str());
    }
}
static void CycleTheme() {
    const Theme* next = NextTheme(g_theme->name);
    g.theme = next->name;
    ApplyTheme(g.theme);
    IniSet(L"Theme", L"Name", g.theme);
    InvalidateRect(g_hwnd, nullptr, TRUE);
}

// ==================== ОКНО ====================
static LRESULT CALLBACK WndProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp) {
    switch (msg) {
    case WM_CREATE:
        g_hwnd = hwnd;
        g_fontTitle = CreateFontW(23, 0, 0, 0, FW_BOLD, TRUE, FALSE, FALSE, DEFAULT_CHARSET,
            OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_SWISS, L"Segoe UI");
        g_font = CreateFontW(16, 0, 0, 0, FW_NORMAL, FALSE, FALSE, FALSE, DEFAULT_CHARSET,
            OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_SWISS, L"Segoe UI");
        g_fontSmall = CreateFontW(12, 0, 0, 0, FW_SEMIBOLD, FALSE, FALSE, FALSE, DEFAULT_CHARSET,
            OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS, CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_SWISS, L"Segoe UI");
        LoadSettings();
        SaveDefaultsIfMissing();
        InstallHooks();
        SetTimer(hwnd, g_uiTimer, 35, nullptr);
        return 0;

    case WM_TIMER:
        if (wp == g_uiTimer) InvalidateRect(hwnd, nullptr, FALSE);
        else if (wp == g_bhopTimer) SendKeyTap(VK_SPACE);
        return 0;

    case WM_ERASEBKGND: return 1;

    case WM_PAINT: {
        PAINTSTRUCT ps{}; HDC dc = BeginPaint(hwnd, &ps);
        RECT r{}; GetClientRect(hwnd, &r);
        HDC mem = CreateCompatibleDC(dc);
        HBITMAP bmp = CreateCompatibleBitmap(dc, r.right, r.bottom);
        auto old = SelectObject(mem, bmp);
        DrawUI(mem, r);
        BitBlt(dc, 0, 0, r.right, r.bottom, mem, 0, 0, SRCCOPY);
        SelectObject(mem, old); DeleteObject(bmp); DeleteDC(mem);
        EndPaint(hwnd, &ps); return 0;
    }

    case WM_LBUTTONDOWN: {
        int x = GET_X_LPARAM(lp), y = GET_Y_LPARAM(lp);
        if (y >= 16 && y <= 40 && x >= 300 && x <= 382) { CycleTheme(); return 0; }
        if (y >= 116 && y <= 138 && x >= 30 && x <= 74) { g.bhopDelay = std::max(1, g.bhopDelay - 1); IniSetInt(L"Bhop", L"Delay", g.bhopDelay); }
        else if (y >= 116 && y <= 138 && x >= 80 && x <= 124) { g.bhopDelay = std::min(100, g.bhopDelay + 1); IniSetInt(L"Bhop", L"Delay", g.bhopDelay); }
        else if (y >= 114 && y <= 139 && x >= 246 && x <= 365) { ChangeBhopKey(); return 0; }
        else if (y >= 182 && y <= 205 && x >= 163 && x <= 207) { g.threshold = std::max(0, g.threshold - 1); IniSetInt(L"Trigger", L"Threshold", g.threshold); }
        else if (y >= 182 && y <= 205 && x >= 213 && x <= 257) { g.threshold = std::min(255, g.threshold + 1); IniSetInt(L"Trigger", L"Threshold", g.threshold); }
        else if (y >= 206 && y <= 228 && x >= 246 && x <= 365) { ChangeTriggerKey(); return 0; }
        else if (y >= 268 && y <= 290 && x >= 30 && x <= 104) { ConfigSave(); return 0; }
        else if (y >= 268 && y <= 290 && x >= 112 && x <= 186) { ConfigLoad(); return 0; }
        else if (y >= 268 && y <= 290 && x >= 194 && x <= 268) { ConfigDelete(); return 0; }
        else if (y >= 302 && y <= 320 && x >= 18 && x <= 180) { ChangeShootKey(); return 0; }
        else if (y >= 302 && y <= 320 && x >= 180 && x <= 382) { ChangeShootDelay(); return 0; }
        InvalidateRect(hwnd, nullptr, TRUE); return 0;
    }

    case WM_KEYDOWN:
        if (wp == VK_ESCAPE) { DestroyWindow(hwnd); return 0; }
        break;

    case WM_DESTROY:
        UninstallHooks();
        KillTimer(hwnd, g_uiTimer);
        if (g_fontTitle) DeleteObject(g_fontTitle);
        if (g_font)      DeleteObject(g_font);
        if (g_fontSmall) DeleteObject(g_fontSmall);
        PostQuitMessage(0); return 0;
    }
    return DefWindowProcW(hwnd, msg, wp, lp);
}

int WINAPI wWinMain(HINSTANCE inst, HINSTANCE, PWSTR, int show) {
    WNDCLASSW wc{};
    wc.lpfnWndProc = WndProc;
    wc.hInstance = inst;
    wc.lpszClassName = kClassName;
    wc.hCursor = LoadCursor(nullptr, IDC_ARROW);
    wc.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);
    wc.style = CS_HREDRAW | CS_VREDRAW;
    if (!RegisterClassW(&wc)) return 1;

    HWND h = CreateWindowExW(0, kClassName, L"nevada - by werty129129",
        WS_OVERLAPPED | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX,
        CW_USEDEFAULT, CW_USEDEFAULT, 410, 375, nullptr, nullptr, inst, nullptr);
    if (!h) return 2;
    ShowWindow(h, show); UpdateWindow(h);

    MSG m{};
    while (GetMessageW(&m, nullptr, 0, 0) > 0) { TranslateMessage(&m); DispatchMessageW(&m); }
    return (int)m.wParam;
}
